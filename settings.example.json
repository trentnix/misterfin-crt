{
  "server": {
    "provider": "jellyfin",
    "url": "http://your-jellyfin-server:8096",
    "insecure_tls": false,
    "transcode": {
      "max_width": 720,
      "max_height": 576,
      "video_bitrate": 12000000
    }
  },
  "ui": {
    "title": "MiSTerVision",
    "show_collections": true,
    "show_playlists": true,
    "navigation_sounds": {
      "enabled": true,
      "volume": 10
    }
  },
  "background": {
    "image": ""
  },
  "display": {
    "interlaced": false
  },
  "input": {
    "profiles": []
  },
  "music_visuals": {
    "default_background": "Starfield",
    "show_audio_meters": true
  },
  "diagnostics": {
    "enabled": false,
    "path": "debug.log",
    "max_bytes": 1048576
  }
}
