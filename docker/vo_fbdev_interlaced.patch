+/* The kernel increments this counter at each output field. Read it without
+ * FBIO_WAITFORVSYNC: that ioctl holds the framebuffer lock while sleeping. */
+static uint32_t pf_field(void)
+{
+    char value[24];
+    ssize_t n;
+    do {
+        n = pread(pf_field_fd, value, sizeof(value) - 1, 0);
+    } while (n < 0 && errno == EINTR);
+    if (n <= 0) {
+        mp_msg(MSGT_VO, MSGL_ERR, "Cannot read interlaced field counter\n");
+        exit(1);
+    }
+    value[n] = 0;
+    char *end;
+    unsigned long field = strtoul(value, &end, 10);
+    if (end == value || (*end && *end != '\n')) {
+        mp_msg(MSGT_VO, MSGL_ERR, "Invalid interlaced field counter\n");
+        exit(1);
+    }
+    return (uint32_t)field;
+}
+
+/* Release the old front page only after the submitted flip reaches a field.
+ * Usually that has already happened during decoding. The short bounded wait
+ * also covers fast frames and paused redraws without adding a whole field. */
+static void pf_release_page(void)
+{
+    if (!pf_pending) return;
+    int64_t deadline = av_gettime_relative() + 60000;
+    while (pf_field() == pf_submitted_field) {
+        if (av_gettime_relative() >= deadline) {
+            mp_msg(MSGT_VO, MSGL_ERR, "Interlaced page release timed out\n");
+            exit(1);
+        }
+        av_usleep(500);
+    }
+    pf_pending = 0;
+}
