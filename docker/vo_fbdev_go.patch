+/* ── MiSTerFin-Go playback overlay ────────────────────────────────────────
+ * Go renders controls once as straight-alpha BGRA pixels. The application
+ * publishes a cropped overlay atomically through OVERLAY_FILE. This video
+ * output driver composites those pixels over the finished decoder frame,
+ * which keeps framebuffer ownership here while video is active.
+ *
+ * Header, little endian: magic[8], canvas w/h, crop x/y/w/h, sequence u64.
+ * The payload is crop-width * crop-height BGRA pixels. */
+#define OVERLAY_FILE "/tmp/misterfin_go_overlay"
+#define OVERLAY_HEADER_SIZE 40
+#define OVERLAY_MAX_BYTES (16u * 1024u * 1024u)
+
+typedef struct {
+    uint8_t *pixels;
+    uint32_t x, y, w, h;
+    uint64_t sequence;
+} go_overlay_t;
+
+static go_overlay_t go_overlay;
+/* Decoders must never expose bare video under a visible overlay. Keep their
+ * destination in RAM, including direct-rendered frames. Paused refreshes reuse
+ * this clean frame, so alpha never accumulates and hiding restores the video. */
+static uint8_t *go_video;
+static uint8_t *go_row;
+
+static int overlay_prepare(void)
+{
+    if (!go_video) go_video = calloc((size_t)fb_line_len, in_height);
+    if (!go_row) go_row = malloc((size_t)in_width * fb_pixel_size);
+    return go_video && go_row;
+}
+
+static uint32_t overlay_le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+           ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint64_t overlay_le64(const uint8_t *p)
+{
+    return (uint64_t)overlay_le32(p) | ((uint64_t)overlay_le32(p + 4) << 32);
+}
+
+static int overlay_read_all(int fd, uint8_t *dst, size_t size)
+{
+    while (size > 0) {
+        ssize_t n = read(fd, dst, size);
+        if (n <= 0) return 0;
+        dst += n;
+        size -= (size_t)n;
+    }
+    return 1;
+}
+
+static void overlay_discard(void)
+{
+    free(go_overlay.pixels);
+    memset(&go_overlay, 0, sizeof(go_overlay));
+}
+
+static void overlay_load(void)
+{
+    uint8_t header[OVERLAY_HEADER_SIZE];
+    struct stat st;
+    int fd = open(OVERLAY_FILE, O_RDONLY);
+    if (fd < 0) {
+        overlay_discard();
+        return;
+    }
+    if (fstat(fd, &st) != 0 || !overlay_read_all(fd, header, sizeof(header)) ||
+        memcmp(header, "MFGOOV1\0", 8) != 0) {
+        close(fd);
+        overlay_discard();
+        return;
+    }
+    uint32_t canvas_w = overlay_le32(header + 8);
+    uint32_t canvas_h = overlay_le32(header + 12);
+    uint32_t x = overlay_le32(header + 16);
+    uint32_t y = overlay_le32(header + 20);
+    uint32_t w = overlay_le32(header + 24);
+    uint32_t h = overlay_le32(header + 28);
+    uint64_t sequence = overlay_le64(header + 32);
+    uint64_t payload_size = (uint64_t)w * h * 4;
+    if (canvas_w != (uint32_t)in_width || canvas_h != (uint32_t)in_height ||
+        !w || !h || x > canvas_w || y > canvas_h ||
+        w > canvas_w - x || h > canvas_h - y ||
+        payload_size > OVERLAY_MAX_BYTES ||
+        (uint64_t)st.st_size != OVERLAY_HEADER_SIZE + payload_size) {
+        close(fd);
+        overlay_discard();
+        return;
+    }
+    if (go_overlay.pixels && go_overlay.sequence == sequence) {
+        close(fd);
+        return;
+    }
+    uint8_t *pixels = malloc((size_t)payload_size);
+    if (!pixels || !overlay_read_all(fd, pixels, (size_t)payload_size)) {
+        free(pixels);
+        close(fd);
+        return;
+    }
+    close(fd);
+    overlay_discard();
+    go_overlay.pixels = pixels;
+    go_overlay.x = x;
+    go_overlay.y = y;
+    go_overlay.w = w;
+    go_overlay.h = h;
+    go_overlay.sequence = sequence;
+}
+
+static void overlay_frame(void)
+{
+    if (!go_video || !go_row) return;
+    overlay_load();
+    for (int y = 0; y < in_height; y++) {
+        uint8_t *video = go_video + (size_t)y * fb_line_len;
+        uint8_t *row = video;
+        if (fb_pixel_size == 4 && go_overlay.pixels &&
+            y >= go_overlay.y && y - go_overlay.y < go_overlay.h) {
+            /* Compose in RAM. Scanout sees only the finished row, never a
+             * restore/erase followed by a separate overlay paint. */
+            memcpy(go_row, video, (size_t)in_width * fb_pixel_size);
+            row = go_row;
+            uint8_t *dst = row + go_overlay.x * 4;
+            uint8_t *src = go_overlay.pixels +
+                (size_t)(y - go_overlay.y) * go_overlay.w * 4;
+            for (uint32_t x = 0; x < go_overlay.w; x++, dst += 4, src += 4) {
+                unsigned a = src[3];
+                for (int c = 0; c < 3; c++)
+                    dst[c] = (uint8_t)((src[c] * a + dst[c] * (255 - a) + 127) / 255);
+            }
+        }
+        memcpy(center + (size_t)y * fb_line_len, row,
+               (size_t)in_width * fb_pixel_size);
+    }
+}
+
