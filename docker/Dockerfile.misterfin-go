FROM debian:bullseye

# Multiarch for armhf headers
RUN dpkg --add-architecture armhf

# Use the snapshot recorded by the base image so package indexes and archives
# cannot move out of sync while rebuilding the MiSTer-compatible glibc target.
RUN sed -i -e '/^deb http/ s/^/# /' \
    -e '/^# deb http:\/\/snapshot/ { s/^# //; s/^deb /deb [check-valid-until=no] /; }' \
    /etc/apt/sources.list

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc-arm-linux-gnueabihf \
    libc6-dev-armhf-cross \
    binutils-arm-linux-gnueabihf \
    libasound2-dev:armhf \
    wget curl make yasm nasm \
    pkg-config \
    bzip2 xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV CROSS=arm-linux-gnueabihf
ENV CC=${CROSS}-gcc
ENV CXX=${CROSS}-g++
ENV AR=${CROSS}-ar
ENV RANLIB=${CROSS}-ranlib
ENV STRIP=${CROSS}-strip
ENV PKG_CONFIG=${CROSS}-pkg-config
ENV PREFIX=/build/sysroot

WORKDIR /build

COPY build-mplayer.sh /build/build-mplayer.sh
COPY vo_fbdev.c /build/vo_fbdev.c
COPY vo_fbdev_go.patch /build/vo_fbdev_go.patch
COPY mplayer_go.patch /build/mplayer_go.patch
COPY font8x8.h /build/font8x8.h
# Apply playback timing changes only in this private Go player build.
RUN patch -p2 < /build/vo_fbdev_go.patch \
    && sed -i '/^cd MPlayer-/a patch -p1 < /build/mplayer_go.patch' /build/build-mplayer.sh \
    && chmod +x /build/build-mplayer.sh

CMD ["/build/build-mplayer.sh"]
